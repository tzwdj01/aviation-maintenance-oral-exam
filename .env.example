# Application / database
APP_ENV=development
DATABASE_URL=sqlite:///./aviation_oral_exam.db
API_V1_PREFIX=/api/v1
ENABLE_DEV_PROVIDER_TEST=false

# Xiaomi MiMo speech (server-side only)
# Canonical names; legacy MIMO_API_BASE_URL is still accepted (see docs/CONFIGURATION.md).
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_VOICEDESIGN_ENABLED=false
MIMO_VOICECLONE_ENABLED=false
MIMO_ASR_LANGUAGE=auto
MIMO_TTS_VOICE=mimo_default
MIMO_TTS_STYLE_PROMPT=请使用清晰、自然、专业的中文口试考官语气。

# Media / audio artifacts
MEDIA_STORAGE_DIR=./media
MEDIA_MAX_SIZE_BYTES=20971520
MEDIA_ALLOWED_MIME_TYPES=["audio/wav","audio/mpeg"]
MEDIA_MAX_DURATION_SECONDS=120
MEDIA_ACCESS_URL_TTL_SECONDS=3600
MEDIA_URL_SECRET=

# Evaluation providers (server-side only)
# Canonical names; legacy DEEPSEEK_API_BASE_URL/DEEPSEEK_MODEL are still accepted.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-pro
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-5

# HTTP controls
AI_CONNECT_TIMEOUT_SECONDS=10
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
